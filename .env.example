# Copy to ".env". File is gitignored — do not commit real passwords.
# Docker Compose reads variables here for DB_* in docker-compose.yml.

# =============================================================================
# Option A — Local Docker (Compose `mysql` service) — use this for ./run-smart-courier-docker.ps1
# =============================================================================
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_USE_SSL=false

# =============================================================================
# Option B — Aiven / cloud MySQL (comment out Option A, uncomment and fill below)
# Empty DB_PASSWORD will fail startup → containers exit → ERR_EMPTY_RESPONSE on :8081 etc.
# =============================================================================
# DB_HOST=your-service.aivencloud.com
# DB_PORT=12345
# DB_USERNAME=avnadmin
# DB_PASSWORD=
# DB_USE_SSL=true
